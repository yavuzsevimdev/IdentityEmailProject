@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 · Sayfa Bulunamadı · Mailora</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #F8F9FD;
      --accent: #8B7FD6;
      --accent-dark: #7467C7;
      --lavender: #EAE6FA;
      --blue: #E8F2FF;
      --mint: #E3F5EE;
      --peach: #FDEEE6;
      --rose: #FBE7EE;
      --card: #FFFFFF;
      --text: #303348;
      --muted: #85899B;
      --border: #ECEBF5;
      --radius: 16px;
      --shadow-sm: 0 1px 2px rgba(48, 51, 72, .04), 0 2px 8px rgba(48, 51, 72, .04);
      --shadow: 0 4px 24px rgba(91, 80, 170, .08);
      --shadow-lg: 0 12px 40px rgba(91, 80, 170, .16);
      --ease: cubic-bezier(.4, 0, .2, 1);

      /* Hata türüne göre JS ile değişen renkler (varsayılan: 404) */
      --tint: var(--lavender);
      --ink: #6F62C6;
    }

    * { box-sizing: border-box; }
    html, body { height: 100%; }

    body {
      margin: 0;
      font-family: "Plus Jakarta Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
      background: var(--bg);
      color: var(--text);
      font-size: 14px;
      -webkit-font-smoothing: antialiased;
      display: flex; flex-direction: column;
      min-height: 100vh;
      overflow-x: hidden;
    }
    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; }

    /* ---------- Üst bar ---------- */
    .topbar { display: flex; align-items: center; padding: 22px 32px; }
    .brand { display: flex; align-items: center; gap: 10px; }
    .brand-logo {
      width: 38px; height: 38px; border-radius: 12px;
      background: linear-gradient(135deg, #A99DF0 0%, var(--accent) 55%, #6F63C4 100%);
      display: grid; place-items: center; color: #fff; font-size: 18px;
      box-shadow: 0 6px 16px rgba(139, 127, 214, .35);
    }
    .brand-name { font-weight: 800; font-size: 20px; letter-spacing: -.4px; }
    .brand-name span { color: var(--accent); }

    /* ---------- Ana alan ---------- */
    .stage {
      flex: 1; display: grid; place-items: center;
      padding: 12px 20px 40px; position: relative;
    }
    .error-card {
      position: relative; overflow: hidden; text-align: center;
      width: min(640px, 100%);
      background: var(--card); border-radius: 24px; box-shadow: var(--shadow);
      padding: 48px 40px 40px;
      animation: pageIn .4s var(--ease);
    }
    .error-card::before, .error-card::after { content: ""; position: absolute; border-radius: 50%; pointer-events: none; }
    .error-card::before { width: 300px; height: 300px; top: -150px; right: -90px; background: var(--tint); opacity: .8; }
    .error-card::after  { width: 220px; height: 220px; bottom: -120px; left: -80px; background: var(--mint); opacity: .7; }
    .error-card > * { position: relative; z-index: 1; }
    @@keyframes pageIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

    /* E-posta illüstrasyonu */
    .illus { position: relative; width: 210px; height: 140px; margin: 0 auto 8px; }
    .illus .env { position: absolute; left: 40px; bottom: 8px; width: 132px; height: 86px; }
    .illus .env::before { content: ""; position: absolute; inset: 0; border-radius: 14px; background: linear-gradient(160deg, #B9B0F2, #8B7FD6); }
    .illus .letter {
      position: absolute; left: 12px; right: 12px; bottom: 20px; height: 86px; z-index: 1;
      background: #fff; border-radius: 10px; padding: 14px 12px;
      box-shadow: 0 6px 16px rgba(91, 80, 170, .15);
      animation: letterUp 3.4s ease-in-out infinite;
    }
    .illus .letter i { display: block; height: 6px; border-radius: 4px; background: var(--lavender); margin-bottom: 7px; }
    .illus .letter i:nth-child(1) { width: 55%; background: #D9D3F7; }
    .illus .letter i:nth-child(2) { width: 85%; }
    .illus .letter i:nth-child(3) { width: 70%; }
    .illus .env-front {
      position: absolute; inset: 0; z-index: 2; border-radius: 14px;
      background: linear-gradient(160deg, #A99EEC, #8073D0);
      clip-path: polygon(0 28%, 50% 70%, 100% 28%, 100% 100%, 0 100%);
    }
    .illus .env-badge {
      position: absolute; top: -14px; right: -12px; z-index: 3;
      width: 38px; height: 38px; border-radius: 50%; border: 3px solid #fff;
      background: var(--ink); color: #fff; font-size: 17px;
      display: grid; place-items: center; box-shadow: 0 6px 14px rgba(48, 51, 72, .2);
    }
    .illus .plane { position: absolute; left: 0; top: 8px; color: var(--accent); font-size: 22px; transform: rotate(-12deg); animation: float 3s ease-in-out infinite; }
    .illus .bubble { position: absolute; border-radius: 50%; animation: float 4s ease-in-out infinite; }
    .illus .b1 { width: 18px; height: 18px; right: 4px; top: 26px; background: var(--mint); }
    .illus .b2 { width: 11px; height: 11px; right: 30px; bottom: 4px; background: var(--tint); animation-delay: .8s; }
    .illus .b3 { width: 14px; height: 14px; left: 18px; bottom: 30px; background: var(--tint); opacity: .8; animation-delay: 1.4s; }
    @@keyframes letterUp { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
    @@keyframes float { 50% { transform: translateY(-8px); } }

    /* Metinler */
    .err-code {
      font-size: clamp(72px, 16vw, 112px); font-weight: 800; letter-spacing: -4px; line-height: 1;
      margin: 6px 0 4px;
      background: linear-gradient(135deg, #B4AAF0 0%, var(--ink) 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .err-kicker {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 12px; font-weight: 700; color: var(--ink); background: var(--tint);
      padding: 5px 12px; border-radius: 20px; margin-bottom: 14px;
    }
    .error-card h1 { font-size: 26px; font-weight: 800; letter-spacing: -.5px; margin: 0 0 10px; }
    .error-card p { color: var(--muted); font-size: 14.5px; line-height: 1.7; margin: 0 auto 28px; max-width: 440px; }

    /* Butonlar */
    .actions { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
    .btn-soft, .btn-main {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 12px 22px; border-radius: 13px; font-weight: 700; font-size: 14px;
      cursor: pointer; transition: all .2s var(--ease);
    }
    .btn-main {
      border: 0; color: #fff;
      background: linear-gradient(135deg, #9C91E2 0%, var(--accent) 50%, var(--accent-dark) 100%);
      box-shadow: 0 8px 20px rgba(139, 127, 214, .38);
    }
    .btn-main:hover { transform: translateY(-2px); box-shadow: 0 12px 26px rgba(139, 127, 214, .45); }
    .btn-soft { border: 1px solid var(--border); background: #fff; color: var(--text); }
    .btn-soft:hover { background: var(--lavender); border-color: #DDD6F7; color: var(--accent-dark); }

    .help { margin-top: 26px; padding-top: 20px; border-top: 1px dashed var(--border); font-size: 12.5px; color: var(--muted); }
    .help a { color: var(--accent-dark); font-weight: 600; }
    .help a:hover { text-decoration: underline; }

    .footer { text-align: center; padding: 0 20px 24px; font-size: 12px; color: #A6A9B8; }

    @@media (max-width: 575.98px) {
      .topbar { padding: 18px 20px; }
      .error-card { padding: 36px 22px 30px; border-radius: 20px; }
      .error-card h1 { font-size: 22px; }
      .actions .btn-soft, .actions .btn-main { flex: 1 1 100%; }
    }
  </style>
</head>

<!-- ==========================================================
     TEK DEĞİŞTİRMEN GEREKEN YER:  data-error="404" | "403" | "401"
     ========================================================== -->
<body data-error="404">

  <header class="topbar">
    <!-- ASP.NET Core MVC: asp-controller="Home" asp-action="Index" -->
    <a class="brand" href="/">
      <div class="brand-logo"><i class="bi bi-envelope-paper-heart-fill"></i></div>
      <div class="brand-name">Mail<span>ora</span></div>
    </a>
  </header>

  <main class="stage">
    <section class="error-card" role="alert">
      <div class="illus" aria-hidden="true">
        <span class="plane"><i class="bi bi-send-fill"></i></span>
        <span class="bubble b1"></span><span class="bubble b2"></span><span class="bubble b3"></span>
        <div class="env">
          <div class="letter"><i></i><i></i><i></i></div>
          <div class="env-front"></div>
          <span class="env-badge"><i class="bi bi-envelope-x" id="errIcon"></i></span>
        </div>
      </div>

      <div class="err-code" id="errCode">404</div>
      <span class="err-kicker"><i class="bi bi-stars"></i> <span id="errKicker">Sayfa bulunamadı</span></span>
      <h1 id="errTitle">Bu sayfa gelen kutusunda yok</h1>
      <p id="errText">Aradığınız sayfa taşınmış, silinmiş ya da hiç var olmamış olabilir. Adresi kontrol edip tekrar deneyin.</p>

      <div class="actions">
        <!-- ASP.NET Core MVC: asp-controller / asp-action ile değiştirilebilir -->
        <a class="btn-main" id="errPrimary" href="/"><i class="bi bi-inbox"></i> <span>Gelen Kutusuna Dön</span></a>
        <button class="btn-soft" type="button" onclick="history.length > 1 ? history.back() : (location.href = '/')"><i class="bi bi-arrow-left"></i> Önceki Sayfa</button>
      </div>

      <div class="help">Sorun devam ediyorsa <a href="mailto:destek@mailora.com">destek@mailora.com</a> adresine yazabilirsiniz.</div>
    </section>
  </main>

  <footer class="footer">© 2026 Mailora · Tüm hakları saklıdır.</footer>

  <script>
    /* Hata türlerine göre içerik. Yeni tür eklemek için buraya bir kayıt eklemek yeterli. */
    const ERRORS = {
      404: {
        kicker: 'Sayfa bulunamadı', title: 'Bu sayfa gelen kutusunda yok',
        text: 'Aradığınız sayfa taşınmış, silinmiş ya da hiç var olmamış olabilir. Adresi kontrol edip tekrar deneyin.',
        icon: 'bi-envelope-x', tint: '#EAE6FA', ink: '#6F62C6',
        btn: { label: 'Gelen Kutusuna Dön', icon: 'bi-inbox', href: '/' }
      },
      403: {
        kicker: 'Erişim engellendi', title: 'Bu sayfaya erişim izniniz yok',
        text: 'Bu içeriği görüntülemek için gerekli yetkiye sahip değilsiniz. Bir hata olduğunu düşünüyorsanız hesap yöneticinizle iletişime geçin.',
        icon: 'bi-shield-lock', tint: '#FDEEE6', ink: '#C8774A',
        btn: { label: 'Gelen Kutusuna Dön', icon: 'bi-inbox', href: '/' }
      },
      401: {
        kicker: 'Oturum gerekli', title: 'Devam etmek için giriş yapın',
        text: 'Bu sayfayı görüntülemek için oturum açmanız gerekiyor. Oturumunuz sona ermiş olabilir, lütfen tekrar giriş yapın.',
        icon: 'bi-person-lock', tint: '#E8F2FF', ink: '#4A7CC2',
        btn: { label: 'Giriş Yap', icon: 'bi-box-arrow-in-right', href: '/Account/Login' }
      }
    };

    const code = document.body.dataset.error;
    const e = ERRORS[code] || ERRORS[404];
    const key = ERRORS[code] ? code : '404';

    document.title = `${key} · ${e.kicker} · Mailora`;
    document.documentElement.style.setProperty('--tint', e.tint);
    document.documentElement.style.setProperty('--ink', e.ink);
    document.getElementById('errCode').textContent = key;
    document.getElementById('errKicker').textContent = e.kicker;
    document.getElementById('errTitle').textContent = e.title;
    document.getElementById('errText').textContent = e.text;
    document.getElementById('errIcon').className = 'bi ' + e.icon;

    const p = document.getElementById('errPrimary');
    p.href = e.btn.href;
    p.innerHTML = `<i class="bi ${e.btn.icon}"></i> <span>${e.btn.label}</span>`;
  </script>
</body>
</html>
