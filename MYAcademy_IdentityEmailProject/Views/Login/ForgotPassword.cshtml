
@{
    Layout = null;
    ViewData["Title"] = "Şifremi Unuttum";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Şifremi Unuttum · Mailora</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #F8F9FD;
            --card: #FFFFFF;
            --accent: #8B7FD6;
            --accent-dark: #7467C7;
            --lavender: #EAE6FA;
            --blue: #E8F2FF;
            --mint: #E3F5EE;
            --text: #303348;
            --muted: #85899B;
            --border: #ECEBF5;
            --danger: #C2476B;
            --shadow-lg: 0 24px 60px rgba(91, 80, 170, .16);
            --ease: cubic-bezier(.4, 0, .2, 1);
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            min-height: 100%;
        }

        body {
            margin: 0;
            font-family: "Plus Jakarta Sans", system-ui, sans-serif;
            background: var(--bg);
            color: var(--text);
            font-size: 14px;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        a {
            color: var(--accent-dark);
            text-decoration: none;
        }

        a:hover {
            color: var(--accent);
        }

        /* Background */
        .auth-bg {
            position: fixed;
            inset: 0;
            z-index: -1;
            overflow: hidden;
            pointer-events: none;
        }

        .auth-bg span {
            position: absolute;
            border-radius: 50%;
            filter: blur(60px);
            opacity: .75;
        }

        .auth-bg .g1 {
            width: 520px;
            height: 520px;
            background: var(--lavender);
            top: -180px;
            left: -140px;
        }

        .auth-bg .g2 {
            width: 460px;
            height: 460px;
            background: var(--blue);
            bottom: -200px;
            right: -120px;
        }

        .auth-bg .g3 {
            width: 300px;
            height: 300px;
            background: var(--mint);
            top: 40%;
            left: 55%;
            opacity: .5;
        }

        /* Page */
        .page {
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 32px 20px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--text);
            margin-bottom: 24px;
        }

        .brand:hover {
            color: var(--text);
        }

        .brand-logo {
            width: 42px;
            height: 42px;
            border-radius: 13px;
            background: linear-gradient(135deg, #A99DF0 0%, var(--accent) 55%, #6F63C4 100%);
            display: grid;
            place-items: center;
            color: #fff;
            font-size: 19px;
            box-shadow: 0 6px 16px rgba(139, 127, 214, .35);
        }

        .brand-name {
            font-weight: 800;
            font-size: 22px;
            letter-spacing: -.4px;
        }

        .brand-name span {
            color: var(--accent);
        }

        /* Card */
        .card-x {
            position: relative;
            width: 100%;
            max-width: 500px;
            background: var(--card);
            border-radius: 28px;
            box-shadow: var(--shadow-lg);
            padding: 40px 40px 30px;
            text-align: center;
            overflow: hidden;
            animation: cardIn .5s var(--ease);
        }

        .card-x::before {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            top: 0;
            height: 150px;
            pointer-events: none;
            background:
                radial-gradient(circle, rgba(255,255,255,.85) 1.4px, transparent 2px) 0 0 / 22px 22px,
                linear-gradient(180deg, #EFEBFC 0%, rgba(239,235,252,0) 100%);
        }

        .card-x > * {
            position: relative;
        }

        @@keyframes cardIn {
            from {
                opacity: 0;
                transform: translateY(14px);
            }
            to {
                opacity: 1;
                transform: none;
            }
        }

        /* Icon */
        .mail-ic {
            position: relative;
            width: 88px;
            height: 88px;
            margin: 0 auto 25px;
        }

        .mail-ic .circle {
            width: 100%;
            height: 100%;
            border-radius: 28px;
            background: linear-gradient(135deg, #B4AAF0, var(--accent) 60%, #6F63C4);
            display: grid;
            place-items: center;
            color: #fff;
            font-size: 38px;
            box-shadow: 0 14px 30px rgba(111, 99, 196, .35);
            animation: bob 3.2s ease-in-out infinite;
        }

        .mail-ic .badge-ic {
            position: absolute;
            right: -8px;
            bottom: -6px;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 4px solid #fff;
            background: #5CC09A;
            color: #fff;
            display: grid;
            place-items: center;
            font-size: 15px;
            box-shadow: 0 6px 14px rgba(92, 192, 154, .35);
        }

        .mail-ic .dot {
            position: absolute;
            border-radius: 50%;
            animation: bob 3s ease-in-out infinite;
        }

        .mail-ic .d1 {
            width: 12px;
            height: 12px;
            background: var(--mint);
            left: -22px;
            top: 14px;
        }

        .mail-ic .d2 {
            width: 8px;
            height: 8px;
            background: #F5CFDC;
            right: -20px;
            top: 6px;
            animation-delay: .8s;
        }

        .mail-ic .d3 {
            width: 10px;
            height: 10px;
            background: var(--blue);
            left: -12px;
            bottom: 2px;
            animation-delay: 1.4s;
        }

        @@keyframes bob {
            50% {
                transform: translateY(-6px);
            }
        }

        /* Content */
        h1 {
            font-size: 25px;
            font-weight: 800;
            letter-spacing: -.6px;
            margin: 0 0 12px;
        }

        .sub {
            color: var(--muted);
            font-size: 14.5px;
            line-height: 1.7;
            margin: 0 auto 28px;
            max-width: 360px;
        }

        /* Form */
        .form-area {
            max-width: 400px;
            margin: 0 auto;
            text-align: left;
        }

        .form-label {
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 9px;
        }

        .input-wrap {
            position: relative;
        }

        .input-wrap i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #A09BBF;
            font-size: 17px;
            pointer-events: none;
        }

        .form-control {
            height: 54px;
            border: 1.5px solid var(--border);
            border-radius: 13px;
            background: var(--bg);
            padding: 12px 15px 12px 46px;
            font-family: inherit;
            font-size: 13.5px;
            color: var(--text);
            transition: .2s var(--ease);
        }

        .form-control::placeholder {
            color: #A8AABC;
        }

        .form-control:focus {
            background: #fff;
            border-color: #BFB6EE;
            box-shadow: 0 0 0 4px rgba(139, 127, 214, .14);
        }

        .validation-summary-errors {
            color: var(--danger);
            font-size: 12.5px;
            margin-bottom: 15px;
        }

        .validation-summary-errors ul {
            padding-left: 18px;
            margin-bottom: 0;
        }

        /* Alert */
        .message-alert {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 13px 15px;
            margin-bottom: 20px;
            border: 1px solid #D8EAE2;
            border-radius: 13px;
            background: #F2FAF6;
            color: #43866D;
            font-size: 12.5px;
            line-height: 1.6;
            text-align: left;
        }

        .message-alert i {
            font-size: 17px;
            margin-top: 1px;
        }

        /* Button */
        .btn-primary-x {
            width: 100%;
            height: 52px;
            margin-top: 20px;
            border: 0;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-family: inherit;
            font-size: 14px;
            font-weight: 700;
            color: #fff;
            background: linear-gradient(135deg, #9C91E2 0%, var(--accent) 50%, var(--accent-dark) 100%);
            background-size: 160% 100%;
            box-shadow: 0 10px 24px rgba(139, 127, 214, .38);
            transition: transform .2s var(--ease), box-shadow .2s var(--ease), background-position .4s var(--ease), opacity .2s;
            cursor: pointer;
        }

        .btn-primary-x:hover {
            color: #fff;
            transform: translateY(-2px);
            background-position: 100% 0;
            box-shadow: 0 14px 30px rgba(139, 127, 214, .45);
        }

        .btn-primary-x:active {
            transform: translateY(0);
        }

        .btn-primary-x.loading {
            opacity: .8;
            cursor: wait;
        }

        .spinner-sm {
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255,255,255,.35);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin .7s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* Information */
        .tip {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin: 22px auto 0;
            max-width: 400px;
            padding: 13px 14px;
            border-radius: 13px;
            background: var(--blue);
            color: #4A7CC2;
            font-size: 12px;
            line-height: 1.6;
            text-align: left;
        }

        .tip i {
            font-size: 15px;
            margin-top: 1px;
        }

        /* Footer */
        .card-foot {
            margin-top: 24px;
            padding-top: 19px;
            border-top: 1px dashed var(--border);
            font-size: 13px;
        }

        .card-foot a {
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .page-foot {
            margin-top: 20px;
            font-size: 12px;
            color: var(--muted);
            text-align: center;
        }

        /* Responsive */
        @@media (max-width: 575.98px) {
            .page {
                padding: 20px 14px;
                justify-content: flex-start;
            }

            .brand {
                margin: 8px 0 18px;
            }

            .card-x {
                padding: 32px 20px 24px;
                border-radius: 24px;
            }

            h1 {
                font-size: 22px;
            }

            .sub {
                font-size: 14px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>

<body>

    <div class="auth-bg" aria-hidden="true">
        <span class="g1"></span>
        <span class="g2"></span>
        <span class="g3"></span>
    </div>

    <main class="page">

        <a class="brand"
           asp-controller="Login"
           asp-action="SignIn"
           aria-label="Mailora giriş sayfası">

            <span class="brand-logo">
                <i class="bi bi-envelope-paper-heart-fill"></i>
            </span>

            <span class="brand-name">Mail<span>ora</span></span>
        </a>

        <section class="card-x">

            <div class="mail-ic" aria-hidden="true">
                <span class="dot d1"></span>
                <span class="dot d2"></span>
                <span class="dot d3"></span>

                <div class="circle">
                    <i class="bi bi-envelope-arrow-up"></i>
                </div>

                <span class="badge-ic">
                    <i class="bi bi-key-fill"></i>
                </span>
            </div>

            <h1>Şifreni mi Unuttun?</h1>

            <p class="sub">
                Hiç sorun değil! Hesabına bağlı e-posta adresini gir.
                Sana şifreni güvenli bir şekilde yenileyebileceğin
                bir bağlantı gönderelim.
            </p>

            @if (ViewBag.Message != null)
            {
                <div class="message-alert">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@ViewBag.Message</span>
                </div>
            }

            <div class="form-area">

                <form asp-controller="Login"
                      asp-action="ForgotPassword"
                      method="post"
                      id="forgotPasswordForm">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All"></div>

                    <label class="form-label" for="email">
                        E-posta adresi
                    </label>

                    <div class="input-wrap">
                        <i class="bi bi-envelope"></i>

                        <input type="email"
                               id="email"
                               name="email"
                               class="form-control"
                               placeholder="ornek@mail.com"
                               autocomplete="email"
                               required />
                    </div>

                    <button type="submit"
                            class="btn-primary-x"
                            id="submitBtn">

                        <i class="bi bi-send-fill"></i>
                        <span>Şifre Yenileme Bağlantısı Gönder</span>

                    </button>

                </form>

            </div>

            <div class="tip">
                <i class="bi bi-info-circle-fill"></i>

                <span>
                    Şifre yenileme bağlantısı e-posta adresine gönderilecektir.
                    Gelen kutunu ve Spam klasörünü kontrol etmeyi unutma.
                    Bağlantıyı yalnızca sen kullanmalısın.
                </span>
            </div>

            <div class="card-foot">
                <a asp-controller="Login"
                   asp-action="SignIn">

                    <i class="bi bi-arrow-left"></i>
                    Giriş sayfasına dön

                </a>
            </div>

        </section>

        <div class="page-foot">
            © 2026 Mailora ·
            <i class="bi bi-lock-fill"></i>
            Bağlantınız SSL ile korunur
        </div>

    </main>

    <script>
        const form = document.getElementById('forgotPasswordForm');
        const submitBtn = document.getElementById('submitBtn');

        form.addEventListener('submit', function () {
            if (!form.checkValidity()) return;

            submitBtn.disabled = true;
            submitBtn.classList.add('loading');

            submitBtn.innerHTML = `
                <span class="spinner-sm"></span>
                <span>E-posta gönderiliyor...</span>
            `;
        });
    </script>

</body>
</html>
