@model SendboxViewModel
@using System.Globalization
@using System.Net
@using System.Security.Claims
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = "Gönderilenler";
    ViewData["ActiveMenu"] = "sent";           // Sidebar'daki data-page="sent" / data-menu="sent" linkini aktif yapar
    Layout = "~/Views/MessageLayout/Index.cshtml";

    var messages = (Model.Messages ?? Enumerable.Empty<Message>()).ToList();
    var readCount = messages.Count(m => m.IsRead);
    var userEmail = User.FindFirstValue(ClaimTypes.Email) ?? User.Identity?.Name ?? "";

    string? CategoryName(Message m) => Model.Categories?.FirstOrDefault(c => c.CategoryId == m.CategoryId)?.CategoryName;
}
@functions {
    static readonly CultureInfo Tr = new("tr-TR");
    static readonly string[] AvatarColors = { "av-lav", "av-blue", "av-mint", "av-rose", "av-peach", "av-sun" };

    // ahmet.yilmaz@alanadi.com → AY · ahmet@alanadi.com → A
    static string Initials(string? email)
    {
        if (string.IsNullOrWhiteSpace(email)) return "?";
        var local = email.Split('@')[0];
        var parts = local.Split(new[] { '.', '_', '-', ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return string.Concat(parts.Take(2).Select(p => p[0])).ToUpper(Tr);
    }

    // Aynı alıcı her zaman aynı renkte görünür
    static string AvatarColor(string? key)
    {
        var h = 0;
        foreach (var c in key ?? "") h = (h * 31 + c) & 0x7fffffff;
        return AvatarColors[h % AvatarColors.Length];
    }

    // HTML içerikten tek satırlık düz metin özet
    static string Snippet(string? html, int max = 140)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";
        var text = WebUtility.HtmlDecode(Regex.Replace(html, "<[^>]+>", " "));
        text = Regex.Replace(text, @"\s+", " ").Trim();
        return text.Length > max ? text[..max].TrimEnd() + "…" : text;
    }

    // Bugün → 10:42 · Dün → Dün · Bu yıl → 4 Kas · Eski → 12.03.2025
    static string ShortTime(DateTime d)
    {
        var today = DateTime.Today;
        if (d.Date == today) return d.ToString("HH:mm", Tr);
        if (d.Date == today.AddDays(-1)) return "Dün";
        if (d.Year == today.Year) return d.ToString("d MMM", Tr);
        return d.ToString("dd.MM.yyyy", Tr);
    }
}

@Html.AntiForgeryToken()

<style>
    .msg-item[hidden] { display: none !important; }
    .msg-item .to-prefix { color: var(--muted, #85899B); font-weight: 500; margin-right: 6px; }
    .msg-item .sender { font-weight: 600; }
    .tag-read { background: var(--mint, #E3F5EE); color: #3E9A77; }
    .tag-sent { background: var(--blue, #E8F2FF); color: #4A7CC2; }
    .favorite-form { display: inline-flex; margin: 0; }
</style>

<section class="inbox" id="inbox">

    <div class="panel list-panel">

        <!-- Başlık + arama + filtreler -->
        <div class="list-head">
            <div class="list-title">
                <div>
                    <h1>Gönderilenler</h1>
                    <div class="sub" id="sentSub" data-email="@userEmail">@messages.Count mesaj · @userEmail</div>
                </div>
                <span class="count-pill" id="readPill">@readCount okundu</span>
            </div>

            <div class="list-tools">

                <div class="list-tools-main">

                    <div class="list-search" id="listSearchWrap">
                        <i class="bi bi-search"></i>
                        <input type="text" id="listSearch" placeholder="Alıcı, konu veya içerik ara" autocomplete="off">
                        <button class="clear" id="listSearchClear" type="button" aria-label="Temizle">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    </div>

                    <div class="filter-chips" id="filterChips"></div>

                </div>

                <div class="category-filter-row">

                    <span class="category-filter-title">
                        <i class="bi bi-folder2"></i>
                        Kategoriler
                    </span>

                    <div class="filter-chips category-chips" id="categoryChips">

                        <button type="button" class="filter-chip active" data-category="all">
                            Tüm Kategoriler
                            <span>@messages.Count</span>
                        </button>

                        @foreach (var category in Model.Categories ?? Enumerable.Empty<dynamic>())
                        {
                            var count = messages.Count(m => m.CategoryId == category.CategoryId);
                            if (count == 0) { continue; }
                            <button type="button" class="filter-chip" data-category="@category.CategoryId">
                                @category.CategoryName
                                <span>@count</span>
                            </button>
                        }

                    </div>

                </div>

            </div>
        </div>

        <!-- Toplu işlemler -->
        <div class="bulk-bar">
            <input type="checkbox" class="m-check" id="checkAll" aria-label="Tümünü seç">
            <span class="sel-info" id="selInfo">Tümünü seç</span>

            <span class="spacer"></span>

            <div class="sort-control">
                <i class="bi bi-sort-down sort-icon"></i>

                <form asp-action="SendBox" method="get" class="sort-form">
                    <select name="sortOrder" class="sort-select" onchange="this.form.submit()">
                        <option value="newest" selected="@(Model.SortOrder != "oldest")">En yeni</option>
                        <option value="oldest" selected="@(Model.SortOrder == "oldest")">En eski</option>
                    </select>
                    <i class="bi bi-chevron-down sort-chevron"></i>
                </form>
            </div>

            <button type="button" class="tool-btn" id="bulkDelete" title="Sil" disabled>
                <i class="bi bi-trash3"></i>
            </button>

            <button type="button" class="tool-btn" id="refreshBtn" title="Yenile">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>

        <!-- Mesaj listesi (sunucu tarafında oluşturulur) -->
        <div class="msg-list" id="msgList">

            @foreach (var m in messages)
            {
                var snippet = Snippet(m.MessageDetail);
                var search = $"{m.ReceiverEmail} {m.Subject} {snippet}".ToLower(Tr);
                var detailUrl = Url.Action("MessageDetail", "Message", new { id = m.MessageId }) ?? $"/Message/MessageDetail/{m.MessageId}";
                var catName = CategoryName(m);

                <article class="msg-item"
                         data-id="@m.MessageId"
                         data-href="@detailUrl"
                         data-read="@(m.IsRead ? "1" : "0")"
                         data-starred="@(m.IsFavorite ? "1" : "0")"
                         data-search="@search"
                         data-category="@m.CategoryId"
                         tabindex="0" title="Mesajı aç">

                    <div class="lead">
                        <input type="checkbox" class="m-check row-check" aria-label="Seç">

                        <form asp-controller="Message" asp-action="ToggleFavorite" method="post" class="favorite-form">
                            <input type="hidden" name="id" value="@m.MessageId" />
                            <button type="submit"
                                    class="star-btn @(m.IsFavorite ? "on" : "")"
                                    aria-label="@(m.IsFavorite ? "Favorilerden çıkar" : "Favorilere ekle")"
                                    title="@(m.IsFavorite ? "Favorilerden çıkar" : "Favorilere ekle")">
                                <i class="bi @(m.IsFavorite ? "bi-star-fill" : "bi-star")"></i>
                            </button>
                        </form>
                    </div>

                    <span class="avatar @AvatarColor(m.ReceiverEmail)">@Initials(m.ReceiverEmail)</span>

                    <div class="mi-sender">
                        <span class="sender"><span class="to-prefix">Kime:</span>@m.ReceiverEmail</span>
                    </div>

                    <div class="mi-main">
                        <span class="subject">@m.Subject</span>
                        <span class="snippet">@snippet</span>
                    </div>

                    <div class="mi-meta">
                        @if (!string.IsNullOrEmpty(catName))
                        {
                            <span class="tag tag-is">@catName</span>
                        }
                        @if (m.IsRead)
                        {
                            <span class="tag tag-read" title="Alıcı mesajı okudu"><i class="bi bi-check2-all"></i> Okundu</span>
                        }
                        else
                        {
                            <span class="tag tag-sent" title="Mesaj iletildi, henüz okunmadı"><i class="bi bi-check2"></i> İletildi</span>
                        }
                    </div>

                    <span class="time" title="@(m.SendDate.ToString("d MMMM yyyy, dddd HH:mm", Tr))">@ShortTime(m.SendDate)</span>
                </article>
            }

            <!-- Hiç mesaj gönderilmemişse -->
            <div class="empty-list" id="emptyBox" hidden="@(messages.Any() ? "hidden" : null)">
                <div class="ic"><i class="bi bi-send"></i></div>
                <h6>Henüz mesaj göndermediniz</h6>
                <div class="mb-3">Gönderdiğiniz mesajlar burada listelenecek.</div>
                <a class="btn-send" asp-action="CreateMessage"><span class="lbl"><i class="bi bi-pencil-square"></i> Yeni Mesaj</span></a>
            </div>

            <!-- Filtre / arama sonucu boşsa -->
            <div class="empty-list" id="noResults" hidden>
                <div class="ic"><i class="bi bi-search-heart"></i></div>
                <h6>Sonuç bulunamadı</h6>
                <div>Arama veya filtre kriterlerini değiştirmeyi deneyin.</div>
            </div>
        </div>

        <!-- Sayfalama -->
        <div class="list-foot">
            <span class="range" id="rangeInfo"></span>
            <div class="pager" id="pager"></div>
        </div>
    </div>

</section>

@section Scripts {
    <script>
        /* ======================================================================
           GÖNDERİLENLER — liste sunucudan gelir; arama, filtre, sayfalama ve
           seçim tarayıcıda yapılır. Yıldız: Message/ToggleFavorite (POST).
           ====================================================================== */
        (() => {
            const { $, $$, showToast } = window.Mailora;

            /* Silme action'ı hazır olunca URL'yi girin (POST, alan: ids). Örn: '/Message/DeleteMessages'
               Boş bırakılırsa silme çalışmaz ve kullanıcıya bilgi verilir. */
            const ENDPOINTS = { delete: '' };
            const PER_PAGE = 10;

            const params = new URLSearchParams(location.search);
            const FILTERS = ['all', 'starred', 'read', 'unread'];
            const state = {
                filter: FILTERS.includes(params.get('filter')) ? params.get('filter') : 'all',
                categoryId: 'all',
                query: params.get('q') || '',
                page: 1,
                selectedId: null,
                checked: new Set()
            };

            const listEl = $('#msgList');
            const norm = s => (s || '').toLocaleLowerCase('tr-TR');
            const rows = () => $$('.msg-item', listEl).filter(r => !r.dataset.removed);
            const rowId = r => +r.dataset.id;
            const isOn = (r, key) => r.dataset[key] === '1';

            /* --- Sunucuya istek (silme için) --- */
            function post(url, data) {
                const body = new URLSearchParams();
                Object.entries(data).forEach(([k, v]) => [].concat(v).forEach(x => body.append(k, x)));
                const token = $('input[name="__RequestVerificationToken"]');
                if (token) body.append('__RequestVerificationToken', token.value);
                return fetch(url, { method: 'POST', body, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(r => { if (!r.ok) throw new Error(r.status); });
            }

            /* --- Filtreleme & sayfalama --- */
            function matches(r) {
                if (state.filter === 'starred' && !isOn(r, 'starred')) return false;
                if (state.filter === 'read' && !isOn(r, 'read')) return false;
                if (state.filter === 'unread' && isOn(r, 'read')) return false;
                if (state.categoryId !== 'all' && r.dataset.category !== state.categoryId) return false;
                const q = norm(state.query.trim());
                if (q && !r.dataset.search.includes(q)) return false;
                return true;
            }
            const filtered = () => rows().filter(matches);
            const pageCount = n => Math.max(1, Math.ceil(n / PER_PAGE));

            function pageRows(all = filtered()) {
                state.page = Math.min(Math.max(1, state.page), pageCount(all.length));
                const start = (state.page - 1) * PER_PAGE;
                return all.slice(start, start + PER_PAGE);
            }

            /* --- Ana çizim --- */
            function render() {
                const all = filtered();
                const visible = new Set(pageRows(all));
                const total = rows().length;

                $$('.msg-item', listEl).forEach(r => {
                    r.hidden = !visible.has(r);
                    r.classList.toggle('selected', rowId(r) === state.selectedId);
                    const checked = state.checked.has(rowId(r));
                    r.classList.toggle('checked', checked);
                    $('.row-check', r).checked = checked;
                });

                $('#emptyBox').hidden = total > 0;
                $('#noResults').hidden = total === 0 || all.length > 0;

                const read = rows().filter(r => isOn(r, 'read')).length;
                const sub = $('#sentSub');
                sub.textContent = total + ' mesaj' + (sub.dataset.email ? ' · ' + sub.dataset.email : '');
                $('#readPill').textContent = read + ' okundu';

                renderPager(all);
                renderChips();
                updateBulkBar();
            }

            function renderPager(all) {
                const pc = pageCount(all.length);
                const start = all.length ? (state.page - 1) * PER_PAGE + 1 : 0;
                const end = Math.min(state.page * PER_PAGE, all.length);
                $('#rangeInfo').textContent = start + '–' + end + ' / ' + all.length + ' mesaj';

                let html = '<button type="button" data-p="prev"' + (state.page === 1 ? ' disabled' : '') + ' aria-label="Önceki"><i class="bi bi-chevron-left"></i></button>';
                for (let i = 1; i <= pc; i++) {
                    html += '<button type="button" data-p="' + i + '" class="' + (i === state.page ? 'active' : '') + '">' + i + '</button>';
                }
                html += '<button type="button" data-p="next"' + (state.page === pc ? ' disabled' : '') + ' aria-label="Sonraki"><i class="bi bi-chevron-right"></i></button>';
                $('#pager').innerHTML = html;
            }

            function renderChips() {
                const all = rows();
                const c = {
                    all: all.length,
                    starred: all.filter(r => isOn(r, 'starred')).length,
                    read: all.filter(r => isOn(r, 'read')).length,
                    unread: all.filter(r => !isOn(r, 'read')).length
                };
                const chips = [['all', 'Tümü'], ['starred', 'Yıldızlı'], ['read', 'Okundu'], ['unread', 'Okunmadı']];
                $('#filterChips').innerHTML = chips.map(([k, t]) =>
                    '<button type="button" class="chip ' + (state.filter === k ? 'active' : '') + '" data-filter="' + k + '">' +
                    t + '<span class="n">' + c[k] + '</span></button>'
                ).join('');
            }

            function updateBulkBar() {
                const ids = pageRows().map(rowId);
                const onPage = ids.filter(id => state.checked.has(id)).length;
                const n = state.checked.size;
                const all = $('#checkAll');
                all.checked = ids.length > 0 && onPage === ids.length;
                all.indeterminate = onPage > 0 && onPage < ids.length;
                $('#selInfo').textContent = n ? n + ' mesaj seçildi' : 'Tümünü seç';
                $('#bulkDelete').disabled = !n;
            }

            /* --- Yıldız (ToggleFavorite formu, sayfa yenilenmeden) --- */
            function setStar(r, on) {
                r.dataset.starred = on ? '1' : '0';
                const btn = $('.star-btn', r);
                btn.classList.toggle('on', on);
                btn.title = on ? 'Favorilerden çıkar' : 'Favorilere ekle';
                $('i', btn).className = 'bi ' + (on ? 'bi-star-fill' : 'bi-star');
            }

            function toggleStar(r, form) {
                const on = !isOn(r, 'starred');
                const btn = $('.star-btn', r);
                setStar(r, on);
                btn.classList.remove('pop'); void btn.offsetWidth; btn.classList.add('pop');
                render();
                showToast(on ? 'Mesaj yıldızlandı.' : 'Yıldız kaldırıldı.', on ? 'bi-star-fill' : 'bi-star');

                // Action yönlendirme (redirect) döndürse bile başarılı sayılır
                fetch(form.action, { method: 'POST', body: new FormData(form), redirect: 'manual', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(res => { if (!(res.ok || res.type === 'opaqueredirect')) throw new Error(res.status); })
                    .catch(() => {
                        setStar(r, !on); render();
                        showToast('İşlem kaydedilemedi.', 'bi-exclamation-circle');
                    });
            }

            /* --- Silme: 5 sn "Geri Al" imkânı, sonra sunucuya gönderilir --- */
            function deleteRows(ids) {
                if (!ENDPOINTS.delete) {
                    showToast('Silme işlemi henüz sunucuya bağlanmadı.', 'bi-info-circle');
                    return;
                }
                const targets = rows().filter(r => ids.includes(rowId(r)));
                if (!targets.length) return;
                targets.forEach(r => { r.dataset.removed = '1'; state.checked.delete(rowId(r)); });
                render();

                let undone = false;
                showToast(targets.length > 1 ? targets.length + ' mesaj çöp kutusuna taşındı.' : 'Mesaj çöp kutusuna taşındı.', 'bi-trash3', {
                    label: 'Geri Al',
                    onClick: () => {
                        undone = true;
                        targets.forEach(r => delete r.dataset.removed);
                        render();
                        showToast('İşlem geri alındı.', 'bi-arrow-counterclockwise');
                    }
                });

                setTimeout(() => {
                    if (undone) return;
                    post(ENDPOINTS.delete, { ids: targets.map(rowId) })
                        .then(() => targets.forEach(r => r.remove()))
                        .catch(() => {
                            targets.forEach(r => delete r.dataset.removed); render();
                            showToast('Mesajlar silinemedi.', 'bi-exclamation-circle');
                        });
                }, 5200);
            }

            function openRow(r) {
                state.selectedId = rowId(r);
                if (r.dataset.href) location.href = r.dataset.href;
            }

            /* --- Arama (liste + navbar senkron) --- */
            const search = $('#listSearch');
            const globalSearch = $('#globalSearch');

            function setQuery(value, source) {
                state.query = value;
                state.page = 1;
                if (source !== 'list') search.value = value;
                if (source !== 'global' && globalSearch) globalSearch.value = value;
                $('#listSearchWrap').classList.toggle('has-value', !!value);
                render();
            }

            /* --- Olaylar --- */
            search.addEventListener('input', e => setQuery(e.target.value, 'list'));
            $('#listSearchClear').addEventListener('click', () => { setQuery('', 'clear'); search.focus(); });

            $('#filterChips').addEventListener('click', e => {
                const chip = e.target.closest('[data-filter]');
                if (!chip) return;
                state.filter = chip.dataset.filter;
                state.page = 1;
                render();
            });

            $('#categoryChips').addEventListener('click', e => {
                const chip = e.target.closest('[data-category]');
                if (!chip) return;
                state.categoryId = chip.dataset.category;
                state.page = 1;
                $$('.filter-chip', $('#categoryChips')).forEach(x => x.classList.toggle('active', x === chip));
                render();
            });

            $('#checkAll').addEventListener('change', e => {
                pageRows().forEach(r => e.target.checked ? state.checked.add(rowId(r)) : state.checked.delete(rowId(r)));
                render();
            });

            $('#bulkDelete').addEventListener('click', () => deleteRows([...state.checked]));
            $('#refreshBtn').addEventListener('click', e => {
                const ic = $('i', e.currentTarget);
                ic.style.transition = 'transform .6s';
                ic.style.transform = 'rotate(360deg)';
                setTimeout(() => location.reload(), 350);
            });

            $('#pager').addEventListener('click', e => {
                const b = e.target.closest('button[data-p]');
                if (!b || b.disabled) return;
                const p = b.dataset.p;
                state.page = p === 'prev' ? state.page - 1 : p === 'next' ? state.page + 1 : +p;
                render();
                listEl.scrollTop = 0;
            });

            // Yıldız formu
            listEl.addEventListener('submit', e => {
                const form = e.target.closest('.favorite-form');
                if (!form) return;
                e.preventDefault();
                toggleStar(form.closest('.msg-item'), form);
            });

            listEl.addEventListener('click', e => {
                const r = e.target.closest('.msg-item');
                if (!r) return;
                if (e.target.closest('.favorite-form') || e.target.closest('.row-check')) return;
                openRow(r);
            });

            listEl.addEventListener('change', e => {
                if (!e.target.classList.contains('row-check')) return;
                const r = e.target.closest('.msg-item');
                e.target.checked ? state.checked.add(rowId(r)) : state.checked.delete(rowId(r));
                r.classList.toggle('checked', e.target.checked);
                updateBulkBar();
            });

            listEl.addEventListener('keydown', e => {
                const r = e.target.closest('.msg-item');
                if (r && e.key === 'Enter' && !e.target.closest('input, button')) openRow(r);
            });

            // Klavye ile gezinme: j / ↓ sonraki, k / ↑ önceki, Enter aç
            function moveCursor(dir) {
                const list = filtered();
                if (!list.length) return;
                let i = list.findIndex(r => rowId(r) === state.selectedId);
                i = i < 0 ? 0 : Math.min(list.length - 1, Math.max(0, i + dir));
                state.selectedId = rowId(list[i]);
                state.page = Math.floor(i / PER_PAGE) + 1;
                render();
                list[i].focus({ preventScroll: true });
                list[i].scrollIntoView({ block: 'nearest' });
            }

            document.addEventListener('keydown', e => {
                if (e.ctrlKey || e.metaKey || e.altKey || e.target.closest('input, textarea, select, [contenteditable="true"]')) return;
                if (e.key === 'j' || e.key === 'ArrowDown') { e.preventDefault(); moveCursor(1); }
                if (e.key === 'k' || e.key === 'ArrowUp')   { e.preventDefault(); moveCursor(-1); }
            });

            /* --- Layout bağlantıları (navbar arama) --- */
            window.Mailora.onSearch = value => setQuery(value, 'global');
            window.Mailora.onLabel = () => { };

            /* --- Başlangıç --- */
            setQuery(state.query, 'init');
        })();
    </script>
}
